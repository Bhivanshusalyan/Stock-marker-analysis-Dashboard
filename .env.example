# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
MONGODB_URI=mongodb://127.0.0.1:27017/stockpulse

# Twelve Data provides quotes and historical series for supported exchanges.
# Leave blank to use clearly-labelled demo snapshots and the TradingView widget.
TWELVE_DATA_API_KEY=

# Optional: a GNews-compatible endpoint/key for automatically retrieved news.
NEWS_API_URL=
NEWS_API_KEY=

# Client (Vite exposes only VITE_ variables)
VITE_API_URL=http://localhost:5000/api
